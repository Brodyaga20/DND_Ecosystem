[node name="Label" type="Label" parent="ColorRect" unique_id=1857359832]
layout_mode = 0
offset_left = 26.0
offset_top = 277.0
offset_right = 998.0
offset_bottom = 404.0
text = "Вернуться на этот экран и изменить данные с этого этапа станет невозможно, только если создать персонажа заново. 
Так происходит потому, что мне лень прописывать логику сохранения данных между сценами, и они будут
храниться только в памяти устройства. 
Можно будет изменить только предысторию и особенности, в уже созданном персонаже.

Вы точно хотите продолжить?"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Yes" type="Button" parent="ColorRect" unique_id=1195167815]
layout_mode = 0
offset_left = 269.0
offset_top = 594.0
offset_right = 423.0
offset_bottom = 668.0
text = "Да"

